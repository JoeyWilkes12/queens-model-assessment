{
  "name": "queens-assessment-book",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "evidence:generate": "node scripts/generate-evidence.mjs",
    "receipts:generate": "node scripts/generate-receipt-chains.mjs",
    "receipts:verify": "node scripts/verify-receipt-chains.mjs",
    "z3:generate": "node scripts/z3/run-python.mjs scripts/z3/build_teaching_data.py && node scripts/verify-z3-teaching.mjs && node scripts/verify-z3-workbench.mjs",
    "greedy:verify": "node scripts/verify-greedy-trajectories.mjs",
    "boards:build": "python3 -I scripts/analysis/build_scoreboard.py && python3 -I scripts/analysis/build_board_receipts.py",
    "boards:verify": "node scripts/verify-board-receipts.mjs",
    "evidence:check-public": "python3 scripts/analysis/public_scrub.py check",
    "z3:verify": "node scripts/z3/run-python.mjs scripts/z3/build_teaching_data.py --verify && node scripts/verify-z3-teaching.mjs && node scripts/verify-z3-workbench.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "ollama:test": "python3 -m unittest discover -s scripts/ollama -p 'test_*.py'",
    "ollama:verify": "python3 scripts/ollama/panel.py verify --require-complete && python3 scripts/ollama/comparisons.py --verify && npm run caveman:verify && npm run local-qwen:verify",
    "caveman:verify": "node --experimental-strip-types scripts/verify-caveman-costs.mjs",
    "local-qwen:verify": "python3 -B scripts/ollama/import_studies.py --verify && node --experimental-strip-types scripts/verify-local-qwen-costs.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.5.4",
    "vite": "^8.3.0"
  }
}
